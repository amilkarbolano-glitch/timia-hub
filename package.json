{
  "name": "timia-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:client": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "lint:real": "tsx scripts/lint-real.ts",
    "smoke": "tsx scripts/smoke.tsx",
    "check": "npm run lint:real && vite build && npm run smoke",
    "api:dev": "cd ../timia-hub-api && python dev_mock.py",
    "docker:up": "docker compose up -d --build",
    "seed:sync": "cp public/db.json ../timia-hub-api/seed.json",
    "e2e:api": "tsx scripts/e2e-api.tsx"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.7",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
