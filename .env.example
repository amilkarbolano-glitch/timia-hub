# Copia a .env y ajusta
WEB_PORT=80
MONGO_DB=timia

# ── Autenticación ────────────────────────────────────────────────────────────
# Secreto para firmar las sesiones (obligatorio en producción): openssl rand -base64 48
SESSION_SECRET=
SESSION_HOURS=8
# true cuando la app se sirve por HTTPS (la cookie de sesión solo viaja cifrada)
COOKIE_SECURE=false
# Google Sign-In: Client ID de tipo "Aplicación web" (console.cloud.google.com → Credenciales)
# Orígenes autorizados: http://localhost y https://<tu-dominio>
GOOGLE_CLIENT_ID=
# Solo estos dominios de correo pueden entrar (coma-separado). Vacío = cualquiera que esté registrado en el panel
ALLOWED_EMAIL_DOMAINS=timia.ai
# Login demo sin contraseña con las cuentas del panel. Vacío = activo solo si NO hay GOOGLE_CLIENT_ID
ALLOW_DEMO_LOGIN=

# ── Servicio ─────────────────────────────────────────────────────────────────
# API key para scripts/integraciones (header X-API-Key). Opcional
TIMIA_API_KEY=
# Solo si el front NO pasa por el nginx del compose (ej. front en S3): https://app.midominio.com
CORS_ORIGINS=
