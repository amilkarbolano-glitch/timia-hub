# Copia a .env. Las variables de la API son las de timia-hub-api/.env.example (se pasan al contenedor api).
WEB_PORT=80
# Ruta al código del backend (repo hermano) para construir la imagen
API_SRC=../timia-hub-api

MONGO_DB=timia
SESSION_SECRET=
SESSION_HOURS=8
COOKIE_SECURE=false
# [GOOGLE] Firebase Authentication (Consola Firebase → Configuración del proyecto → SDK config)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Alternativa sin Firebase: Client ID OAuth "Aplicación web"
GOOGLE_CLIENT_ID=
ALLOWED_EMAIL_DOMAINS=timia.ai
ALLOW_DEMO_LOGIN=
TIMIA_API_KEY=
CORS_ORIGINS=
SEED_ON_START=true
